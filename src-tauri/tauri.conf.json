{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Annotator",
  "version": "0.1.0",
  "identifier": "com.jung.pdfannotator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Annotator",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF / Markdown / DOCX snippet annotator with grouping and lineage view",
    "longDescription": "Annotate PDFs, Markdown, and Word documents. Capture text and image snippets, group them visually, and trace document lineage. Sidecars next to source files; no upload required.",
    "copyright": "© 2026 Jung Hoon Son",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
